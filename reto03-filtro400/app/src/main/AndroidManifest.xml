<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".CentinelaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/filtro400_logo"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/filtro400_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Filtro400">
        <!-- Registramos nuestro servicio de filtrado. Android lo llamará
     solo cuando entre una llamada y el usuario nos haya dado el rol. -->
        <service
            android:name=".FiltroLlamadasService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>
        <service
            android:name=".NumeroCompletoPurgeJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Filtro400"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
